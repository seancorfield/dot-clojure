#!/bin/sh

if test -f .nrepl-port
then
  if test "$1" = "force"
  then
    shift
  else
    echo ".nrepl-port exists: $(cat .nrepl-port)"
    exit 1
  fi
fi

# in case we need the older behavior, with cider, before the cli repl is fixed:
repl_alias=:rephrase:repl
if test "$1" = "cider"
then
  shift
  repl_alias=:rebel:dev/repl
fi

# since clojure complains about -A and -M together, do our own stitching:
extra_aliases=""
prefix=$(echo "$1" | cut -c1-2)
if test "$prefix" = "-A"
then
  aliases=$(echo "$1" | cut -c3-)
  extra_aliases=":$aliases"
  shift
fi

clojure "$@" -M:slf4j-nop:1.13:allow-attach-self"$extra_aliases":test:portal:cider-nrepl"$repl_alias"
