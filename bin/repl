#!/bin/sh

if test -f .nrepl-port
then
  if test "$1" = "force"
  then
    shift
  else
    echo ".nrepl-port exists: $(cat .nrepl-port)"
    exit 1
  fi
fi

# in case we need the older behavior, with cider, before the cli repl is fixed:
repl_alias=:rephrase:repl
if test "$1" = "cider"
then
  shift
  repl_alias=:rebel:dev/repl
fi

clojure "$@" -M:1.13:allow-attach-self:portal:test:cider-nrepl"$repl_alias"
